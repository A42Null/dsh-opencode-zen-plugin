{
  "name": "@a42null/dsh-opencode-zen-plugin",
  "version": "0.3.6",
  "description": "OpenCode Console (Zen) models for DeepSeek Harness (DSH): fill in your Console API key under Settings → Plugins and the Console's chat models become selectable.",
  "type": "module",
  "main": "lib/index.js",
  "readmeFilename": "README.zh-CN.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A42Null/dsh-opencode-zen-plugin.git"
  },
  "homepage": "https://github.com/A42Null/dsh-opencode-zen-plugin#readme",
  "bugs": {
    "url": "https://github.com/A42Null/dsh-opencode-zen-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-zen",
    "opencode-console",
    "cordis",
    "cordis-plugin",
    "llm-adapter",
    "llm-provider",
    "llm"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
